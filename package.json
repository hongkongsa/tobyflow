{
  "name": "tobyflow-v2",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.svelte",
    "lint:fix": "eslint src/ --ext .ts,.svelte --fix",
    "format": "prettier --write \"src/**/*.{ts,svelte,css,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "server": "node server/index.js",
    "dev:all": "concurrently \"pnpm server\" \"pnpm dev\""
  },
  "dependencies": {
    "dexie": "^4.0.0",
    "drawflow": "^0.0.60",
    "i18next": "^24.0.0",
    "webext-bridge": "^6.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.0.287",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "autoprefixer": "^10.4.0",
    "cors": "^2.8.6",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^2.0.0",
    "express": "^5.2.1",
    "playwright": "^1.48.0",
    "postcss": "^8.4.0",
    "prettier": "^3.4.0",
    "prettier-plugin-svelte": "^3.3.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
